# Copie para .env.local (ignorado pelo Git) após confirmar o projeto de destino.
# Valores vazios são intencionais: nenhuma conexão falsa ou chave de demonstração.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Estas duas configurações são públicas e entram no bundle.
# NUNCA coloque secret key, service_role, senha do banco ou tokens neste arquivo.

# Desabilitado por padrão. O código atual só aceita o projeto descartável aprovado.
EXPO_PUBLIC_ACCOUNT_DELETION_ENABLED=false
EXPO_PUBLIC_ACCOUNT_DELETION_PROJECT_REF=
