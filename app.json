{
  "expo": {
    "name": "FalaAi",
    "slug": "FalaAi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "falaai",
    "userInterfaceStyle": "light",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.ivysonsiqueira.falaai"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o FalaAí acesse fotos para anexar à ocorrência.",
          "cameraPermission": "Permitir que o FalaAí use a câmera para fotografar o problema.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o FalaAí obtenha sua localização para registrar o local da ocorrência."
        }
      ],
      "expo-dev-client",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f0217604-bc3e-45a0-a88d-94e33fd7aba8"
      }
    },
    "owner": "ivysonsiqueira"
  }
}
